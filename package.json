{
  "name": "net-fast-debug",
  "displayName": ".NET Fast Debug - C# minimalist Debugger.",
  "description": "Debug C# projects from a *.csproj file of .NET 6.0 or later, with a minimalist approach.",
  "version": "1.0.1",
  "publisher": "BrianAthayde",
  "license": "MIT",
  "icon": "images/net-fast-debug-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianathayde/net-fast-debug.git"
  },
  "bugs": {
    "url": "https://github.com/brianathayde/net-fast-debug/issues"
  },
  "homepage": "https://github.com/brianathayde/net-fast-debug#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "dotnet",
    ".net",
    "csharp",
    "c#",
    "debug",
    "debugger",
    "csproj"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": ".NET Fast Debug",
      "properties": {
        "dotnetFastDebug.windowsConsole": {
          "type": "string",
          "enum": [
            "internalConsole",
            "integratedTerminal",
            "externalTerminal"
          ],
          "default": "integratedTerminal",
          "description": "Which console the extension should use for debug sessions on Windows."
        },
        "dotnetFastDebug.unixConsole": {
          "type": "string",
          "enum": [
            "internalConsole",
            "integratedTerminal",
            "externalTerminal"
          ],
          "default": "integratedTerminal",
          "description": "Which console the extension should use for debug sessions on macOS and Linux."
        }
      }
    },
    "commands": [
      {
        "command": "dotnet-fast-debug.debugInNewTerminal",
        "title": "Debug in Integrated Terminal"
      },
      {
        "command": "dotnet-fast-debug.noRestoreDebugInNewTerminal",
        "title": "Fast Debug in Integrated Terminal"
      },
      {
        "command": "dotnet-fast-debug.noRestoreNoDependenciesDebugInNewTerminal",
        "title": "Fastest Debug in Integrated Terminal"
      }
    ],
    "submenus": [
      {
        "id": "dotnet-fast-debug.fastDotnetDebug",
        "label": ".NET Fast Debug"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "dotnet-fast-debug.fastDotnetDebug",
          "when": "resourceExtname == .csproj",
          "group": "navigation"
        }
      ],
      "dotnet-fast-debug.fastDotnetDebug": [
        {
          "command": "dotnet-fast-debug.debugInNewTerminal",
          "when": "resourceExtname == .csproj",
          "group": "navigation@1"
        },
        {
          "command": "dotnet-fast-debug.noRestoreDebugInNewTerminal",
          "when": "resourceExtname == .csproj",
          "group": "navigation@2"
        },
        {
          "command": "dotnet-fast-debug.noRestoreNoDependenciesDebugInNewTerminal",
          "when": "resourceExtname == .csproj",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "vscode:prepublish": "npm run clean && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile",
    "package": "vsce package",
    "publish:marketplace": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}
